# =============================================================================
# MD Translation Prototype — Environment Variables
# List is to delineate what's required and enable running locally
# Copy this file to .env and fill in the values.
# DO NOT commit .env to the repo.
# =============================================================================


# -----------------------------------------------------------------------------
# API Keys
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# -----------------------------------------------------------------------------
# Google Drive Folders
# -----------------------------------------------------------------------------
# Folder where source PDFs are uploaded for processing
DRIVE_INPUT_FOLDER_ID=

# Folder where extraction JSON output is stored
DRIVE_EXTRACTION_JSON_FOLDER_ID=

# Folder where translation JSON output is stored
DRIVE_TRANSLATION_JSON_FOLDER_ID=

# Folder where eval results are stored
DRIVE_EVAL_RESULTS_FOLDER_ID=

# Folder where output Google Docs are created for reviewer
DRIVE_OUTPUT_DOCS_FOLDER_ID=

# Folder where raw feedback diffs are stored
DRIVE_FEEDBACK_FOLDER_ID=

# Absolute path to a local PDF for testing extract without Drive access (local dev only)
LOCAL_PDF_PATH=

# Absolute path to a local translation JSON for testing evals without Drive access (local dev only)
LOCAL_TRANSLATION_JSON_PATH=

# Absolute path to a local eval rubric for testing evals without Docs access (local dev only)
LOCAL_RUBRIC_PATH=

# Absolute path to a local translation prompt for the drift eval without Docs access (local dev only)
LOCAL_TRANSLATION_PROMPT_PATH=

# Absolute path to a local CSV for quality eval results, used instead of
# EVAL_QUALITY_RESULTS_SHEET_ID when set (local dev only, no Google credentials needed)
LOCAL_EVAL_RESULTS_CSV=

# Absolute path to a local CSV for drift eval results, used instead of
# EVAL_DRIFT_RESULTS_SHEET_ID when set (local dev only, no Google credentials needed)
LOCAL_DRIFT_RESULTS_CSV=

# -----------------------------------------------------------------------------
# Google Docs
# -----------------------------------------------------------------------------
# Translation prompt — style guide, tone criteria, golden examples
TRANSLATION_PROMPT_DOC_ID=

# Extraction prompt — instructions for identifying text blocks from PDFs
EXTRACTION_PROMPT_DOC_ID=

# Evaluation rubric — criteria for LLM-as-judge scoring
EVALUATION_RUBRIC_DOC_ID=

# Output template — formatting-only doc copied by Translate function
OUTPUT_TEMPLATE_DOC_ID=

# -----------------------------------------------------------------------------
# Google Sheets
# -----------------------------------------------------------------------------
# Model config — provider, model ID, active flag, role
MODEL_CONFIG_SHEET_ID=

# Glossary — terminology decisions accumulated from reviewer feedback
GLOSSARY_SHEET_ID=
GLOSSARY_SHEET_TAB_GID=

# Golden translation set — source/reference pairs for drift eval
GOLDEN_SET_SHEET_ID=
# Local override: read the golden set from a .xlsx/.csv/.json export instead of the Sheet (local dev only)
GOLDEN_SET_LOCAL_PATH=
# For golden sets whose columns are titled by language (e.g. English/Spanish) rather than
# "Source Text"/"Reference Translation": name the source/reference columns (they also label the languages)
GOLDEN_SOURCE_COLUMN=
GOLDEN_REFERENCE_COLUMN=

# Drift regression thresholds — optional; defaults live in eval/drift/main.py
# (BLEU 30.0, ROUGE-L 0.40, judge 3.0). Set to override without a code change.
DRIFT_BLEU_BASELINE=
DRIFT_ROUGE_L_BASELINE=
DRIFT_JUDGE_BASELINE=
# Bounded concurrency for scoring golden examples (default 4)
DRIFT_MAX_WORKERS=

# Eval results — scores from drift and quality evals
EVAL_DRIFT_RESULTS_SHEET_ID=
EVAL_QUALITY_RESULTS_SHEET_ID=

# Sheet where we store file IDs of docs already processed
PROCESSING_LOG_SHEET_ID=

# Sheet where we store terminology decisions captured in the Capture Feedback step
DERIVED_GLOSSARY_SHEET_ID=

# -----------------------------------------------------------------------------
# GCP (populate once project is provisioned)
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=
GCP_REGION=
PUBSUB_TOPIC_EXTRACTION_COMPLETE=
CLOUD_RUN_SERVICE_ACCOUNT_EMAIL=

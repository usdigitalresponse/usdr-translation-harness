      },
      {
        "xPos": 8,
        "yPos": 16,
        "width": 4,
        "height": 4,
        "widget": {
          "title": "Translate — Output Tokens/sec (throughput)",
          "xyChart": {
            "dataSets": [
              {
                "timeSeriesQuery": {
                  "timeSeriesQueryLanguage": "{ t0: fetch cloud_run_revision | metric 'logging.googleapis.com/user/translate_output_tokens' | align delta(1h) | group_by [metric.model], mean(val()) ; t1: fetch cloud_run_revision | metric 'logging.googleapis.com/user/translate_duration_ms' | align delta(1h) | group_by [metric.model], mean(val()) } | join | div | mul 1000"
                },
                "plotType": "LINE"
              }
            ],
            "yAxis": { "label": "tokens/sec" }
          }
        }
      },

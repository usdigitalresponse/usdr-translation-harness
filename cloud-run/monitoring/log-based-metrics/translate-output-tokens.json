{
  "name": "translate_output_tokens",
  "description": "Output tokens returned by the LLM during translation",
  "filter": "resource.type=\"cloud_run_revision\" jsonPayload.pipeline_stage=\"translate\" jsonPayload.output_tokens:*",
  "metricDescriptor": {
    "metricKind": "DELTA",
    "valueType": "DISTRIBUTION",
    "labels": [
      { "key": "provider", "valueType": "STRING" },
      { "key": "model", "valueType": "STRING" }
    ]
  },
  "valueExtractor": "EXTRACT(jsonPayload.output_tokens)",
  "bucketOptions": {
    "exponentialBuckets": {
      "numFiniteBuckets": 12,
      "growthFactor": 2,
      "scale": 500
    }
  },
  "labelExtractors": {
    "provider": "EXTRACT(jsonPayload.provider)",
    "model": "EXTRACT(jsonPayload.model)"
  }
}
